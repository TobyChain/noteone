# NoteOne server environment — copy to .env and fill in.

# Runtime mode: development | production
NODE_ENV=development
PORT=3000
# Bind to loopback by default. Set 0.0.0.0 only with NOTEONE_ACCESS_TOKEN.
HOST=127.0.0.1
NOTEONE_ACCESS_TOKEN=
# Only for a container/runtime whose outer port is verifiably loopback-only.
TRUST_EXTERNAL_LOOPBACK_BINDING=false
ENABLE_DEV_LOGIN=false

# Postgres (pgvector) connection string — REQUIRED
DATABASE_URL=postgres://noteone:noteone@localhost:5432/noteone

# JWT signing secret — REQUIRED. Use a long random value (>= 16 chars).
JWT_SECRET=

# CORS allow-list (comma-separated origins). Empty => reflect request origin.
ALLOWED_ORIGINS=

# LLM provider (OpenAI-compatible API)
QWEN_API_KEY=your-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
